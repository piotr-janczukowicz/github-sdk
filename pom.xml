<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.piotr-janczukowicz</groupId>
    <artifactId>common-parent</artifactId>
    <version>15</version>
    <relativePath/>
  </parent>

  <artifactId>github-sdk</artifactId>
  <version>2026.3.10.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>github-sdk</name>
  <description>Object layer over github-rest-client: models that carry methods calling the GitHub REST API</description>
  <url>https://github.com/piotr-janczukowicz/github-sdk</url>

  <properties>
    <github-rest-client.version>2026.3.10.4</github-rest-client.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>github-rest-client</artifactId>
      <version>${github-rest-client.version}</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>unit</groups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <groups>integration</groups>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
            <include>**/*ITCase.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>smoke</id>
      <properties>
        <jacoco.skip>true</jacoco.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <groups combine.self="override">smoke</groups>
              <includes combine.children="override">
                <include>**/smoke/*SmokeIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
